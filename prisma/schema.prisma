generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model SessionStat {
  id     String   @id @default(uuid())
  userId String
  n      Int
  avgWpm Int
  avgAcc Float
  date   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlayerProfile {
  id           String  @id @default(uuid())
  userId       String  @unique
  username     String
  level        Int     @default(1)
  xp           Int     @default(0)
  achievements Json    @default("[]")
  avatar       String?
  user         User    @relation(name: "UserProfile", fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("player_profile")
}

model User {
  id            String         @id @default(uuid())
  username      String        @unique
  passwordHash  String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  // role          String         @default("user") // e.g., "user", "admin", "moderator"

  accounts      Account[]
  sessions      Session[]
  sessionStats  SessionStat[]
  profile PlayerProfile? @relation(name: "UserProfile")

  // Optional for WebAuthn support
  Authenticator Authenticator[]

  resetToken            String?
  resetTokenExpiry      DateTime?
  passwordResetRequests Int       @default(0)

  emailVerifyToken          String?   @unique
  emailVerifyTokenExpiry    DateTime?
  emailVerificationAttempts Int?      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model RateLimit {
  ip          String   @id
  count       Int
  lastUpdated DateTime @updatedAt
}
