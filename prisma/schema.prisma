generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model SessionStat {
  id     String   @id @default(uuid())
  userId String
  n      Int
  avgWpm Int
  avgAcc Float
  date   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyTypingActivity {
  id               String @id @default(uuid())
  userId           String
  /// Local date key (YYYY-MM-DD) computed client-side for the user.
  localDate        String
  sessionsCount    Int    @default(0)
  totalTimeSpentSec Int   @default(0)
  sumWpm           Float  @default(0)
  /// Time-weighted WPM numerator: sum(wpm * timeSpentSec). Daily avg WPM = sumWpmTime / totalTimeSpentSec.
  sumWpmTime       Float  @default(0)
  sumAccuracy      Float  @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, localDate])
  @@index([userId, localDate])
  @@map("daily_typing_activity")
}

model PlayerProfile {
  id           String  @id @default(uuid())
  userId       String  @unique
  username     String
  level        Int     @default(1)
  xp           Int     @default(0)
  rating       Int     @default(1000)
  ratingDeviation Int  @default(350)
  ratingUpdatedAt DateTime?
  achievements Json    @default("[]")
  longTermStats Json?
  avatar       String?
  hideFromLeaderboard Boolean @default(false)
  user         User    @relation(name: "UserProfile", fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rating])

  @@map("player_profile")
}

model LeaderboardSnapshot {
  id          String   @id @default(uuid())
  snapshotKey String   @default("global")
  userId      String
  position    Int
  username    String
  avatar      String?
  rating      Int
  updatedAt   DateTime
  refreshedAt DateTime
  createdAt   DateTime @default(now())

  @@unique([snapshotKey, userId])
  @@unique([snapshotKey, position])
  @@index([snapshotKey, position])
  @@index([snapshotKey, refreshedAt])
  @@map("leaderboard_snapshot")
}

model LeaderboardSnapshotMeta {
  snapshotKey String   @id
  refreshedAt DateTime?
  rowCount    Int      @default(0)
  stale       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("leaderboard_snapshot_meta")
}

model User {
  id            String         @id @default(uuid())
  username      String        @unique
  usernameLastChangedAt DateTime?
  passwordHash  String?
  email         String         @unique
  pendingEmail  String?        @unique
  pendingEmailRequestedAt DateTime?
  emailVerified DateTime?
  verificationReminderShownAt DateTime?
  image         String?
  role          String         @default("user")
  banned        Boolean        @default(false)
  isPrimaryAdmin Boolean       @default(false)

  accounts      Account[]
  sessions      Session[]
  sessionStats  SessionStat[]
  dailyTypingActivity DailyTypingActivity[]
  profile PlayerProfile? @relation(name: "UserProfile")

  pvpRoomsCreated PvpRoom[] @relation("PvpRoomCreated")
  pvpRoomsHosted PvpRoom[] @relation("PvpRoomHost")
  pvpRoomMemberships PvpRoomMember[]
  pvpMatchParticipants PvpParticipant[]
  pvpRating PvpRating?
  pvpRatingChanges PvpRatingChange[]
  pvpMatchmakingPreference PvpMatchmakingPreference?
  cheatFlags    CheatFlag[]
  adminActions  AdminActionLog[] @relation("AdminActionActor")
  adminTargets  AdminActionLog[] @relation("AdminActionTarget")
  submittedFeedback UserFeedback[] @relation("UserFeedbackAuthor")
  respondedFeedback UserFeedback[] @relation("UserFeedbackResponder")

  // Optional for WebAuthn support
  Authenticator Authenticator[]

  resetToken            String?
  resetTokenExpiry      DateTime?
  passwordResetRequests Int       @default(0)

  emailVerifyToken          String?   @unique
  emailVerifyTokenExpiry    DateTime?
  emailVerificationAttempts Int?      @default(0)

  emailVerifyOtpHash           String?
  emailVerifyOtpExpiry         DateTime?
  emailVerifyOtpSentAt         DateTime?
  emailVerifyOtpFailedAttempts Int      @default(0)
  pvpWsTokenVersion            Int       @default(0)
  pvpWsTokensValidAfter        DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserFeedback {
  id                String   @id @default(uuid())
  userId            String
  category          String
  status            String   @default("OPEN")
  subject           String
  body              String
  rating            Int?
  imageUrl          String?
  adminReplyTitle   String?
  adminReplyBody    String?
  respondedByUserId String?
  respondedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user        User  @relation("UserFeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)
  respondedBy User? @relation("UserFeedbackResponder", fields: [respondedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([category, createdAt])
  @@index([userId, createdAt])
}

model AdminActionLog {
  id           String   @id @default(uuid())
  actorUserId  String
  targetUserId String?
  action       String
  entityType   String
  entityId     String?
  summary      String
  metadata     Json?
  createdAt    DateTime @default(now())

  actorUser  User  @relation("AdminActionActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  targetUser User? @relation("AdminActionTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([entityType, createdAt])
}

model PvpRoom {
  id              String   @id @default(uuid())
  code            String   @unique
  status          String   @default("OPEN")
  visibility      String   @default("PRIVATE")
  createdByUserId String
  hostUserId      String
  minPlayers      Int      @default(2)
  maxPlayers      Int      @default(6)
  /// Optional pre-selected text snapshot for the next match in this room.
  textSnapshot    String?
  autoStartAt     DateTime?
  expiresAt       DateTime?

  createdBy User @relation("PvpRoomCreated", fields: [createdByUserId], references: [id], onDelete: Cascade)
  host      User @relation("PvpRoomHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  members   PvpRoomMember[]
  matches   PvpMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([visibility, status, createdAt])
  @@map("pvp_room")
}

model PvpMatchmakingPreference {
  id             String   @id @default(uuid())
  userId         String   @unique
  preferredMode  String   @default("ranked_1v1")
  textDifficulty String   @default("normal")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pvp_matchmaking_preference")
}

model PvpRoomMember {
  id        String   @id @default(uuid())
  roomId    String
  userId    String
  colorSlot Int
  readyAt   DateTime?
  joinedAt  DateTime @default(now())
  leftAt    DateTime?

  room PvpRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("pvp_room_member")
}

model PvpMatch {
  id              String   @id @default(uuid())
  status          String   @default("PENDING")
  roomId          String?
  /// Distributed authoritative lifecycle snapshot for active matches.
  liveState       Json?
  /// Monotonic revision used for optimistic concurrency and reconnect resume.
  revision        Int      @default(0)
  /// Gateway instance currently responsible for match lifecycle work.
  instanceId      String?
  /// The canonical text used by all participants in the match.
  textSnapshot    String
  textId          String?
  inputNonce      String?
  serverStartAt   DateTime?
  startedAt       DateTime?
  endedAt         DateTime?

  room         PvpRoom?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  participants PvpParticipant[]
  events       PvpEvent[]
  ratingChanges PvpRatingChange[]
  cheatFlags   CheatFlag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([status, instanceId, updatedAt])
  @@index([instanceId, updatedAt])
  @@map("pvp_match")
}

model PvpParticipant {
  id              String   @id @default(uuid())
  matchId         String
  userId          String
  slot            Int
  finalWpm        Int?
  finalAccuracy   Float?
  finalErrors     Int?
  timeSpentSec    Int?
  completedAt     DateTime?
  disconnectCount Int      @default(0)

  match PvpMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([matchId])
  @@map("pvp_participant")
}

model PvpEvent {
  id      String   @id @default(uuid())
  matchId String
  seq     Int
  type    String
  payload Json

  match PvpMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([matchId, seq])
  @@index([matchId, createdAt])
  @@map("pvp_event")
}

model PvpRating {
  id          String   @id @default(uuid())
  userId      String   @unique
  rating      Int      @default(1500)
  deviation   Int      @default(350)
  gamesPlayed Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rating])
  @@map("pvp_rating")
}

model PvpRatingChange {
  id           String   @id @default(uuid())
  matchId      String
  userId       String
  beforeRating Int
  afterRating  Int
  delta        Int

  match PvpMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([matchId, userId])
  @@index([userId, createdAt])
  @@map("pvp_rating_change")
}

model CheatFlag {
  id            String   @id @default(uuid())
  userId        String
  matchId       String
  confidence    Float
  flags         String[]
  reviewed      Boolean  @default(false)
  wouldSanction Boolean  @default(false)
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match PvpMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([userId, createdAt])
  @@index([reviewed, createdAt])
  @@map("cheat_flag")
}

model PendingSignup {
  id String @id @default(uuid())

  email        String @unique
  username     String @unique
  passwordHash String

  emailVerifyToken       String   @unique
  emailVerifyTokenExpiry DateTime
  emailVerificationAttempts Int   @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pending_signup")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model RateLimit {
  ip          String   @id
  count       Int
  lastUpdated DateTime @updatedAt
}
