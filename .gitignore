# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js - تجاهل جميع مجلدات البناء والـ cache (بما في ذلك .next-dev إذا وجد)
/.next/
/.next-dev/
/.next*/
/out/
/build

# Production build (بعض المشاريع تستخدم build بدلاً من .next)
/build

# Misc
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Local env files - لا ترفع أبدًا الملفات الحساسة
.env*
!.env.example    # إذا كان لديك ملف مثالي عام، يمكن رفعه

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Logs
/logs
/logs/*
*.log

# Custom data folders (مثل قاعدة بيانات محلية أو بيانات حساسة)
/lib/db/data
*/lib/db/data

# IDE / Editor files (اختياري لكن مفيد)
.idea/
.vscode/
*.swp
*.swo

# OS generated files
Thumbs.db