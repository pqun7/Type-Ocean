{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "clean build",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/d",
				"/c",
				"if exist .next rmdir /s /q .next & npm run build"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "full jest",
			"type": "shell",
			"command": "npx",
			"args": [
				"jest",
				"--no-coverage",
				"--runInBand",
				"--forceExit"
			],
			"isBackground": false
		},
		{
			"label": "pvp gateway build",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"pvp:gateway:build"
			],
			"isBackground": false
		},
		{
			"label": "pvp gateway start force bot",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/d",
				"/c",
				"set PVP_TEST_FORCE_BOT_MATCH=true&&set PVP_AI_QUEUE_TIMEOUT_MS=1500&&npm run pvp:gateway:start"
			],
			"isBackground": true
		},
		{
			"label": "pvp websocket prepare",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/d",
				"/c",
				"if not exist load-tests\\pvp-websocket\\artifacts\\latest mkdir load-tests\\pvp-websocket\\artifacts\\latest&&node load-tests\\pvp-websocket\\prepare-load-window.cjs > load-tests\\pvp-websocket\\artifacts\\latest\\prepare-task.log 2>&1"
			],
			"isBackground": false
		},
		{
			"label": "pvp websocket verify current",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/d",
				"/c",
				"load-tests\\pvp-websocket\\run-verify-current.cmd"
			],
			"isBackground": false
		},
		{
			"label": "pvp websocket verify default",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/d",
				"/c",
				"load-tests\\pvp-websocket\\run-default-verify.cmd"
			],
			"isBackground": false
		},
		{
			"label": "pvp websocket verify ai-stress",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/d",
				"/c",
				"load-tests\\pvp-websocket\\run-ai-stress-verify.cmd"
			],
			"isBackground": false
		},
		{
			"label": "pvp websocket strict",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/d",
				"/c",
				"load-tests\\pvp-websocket\\run-strict.cmd"
			],
			"isBackground": false
		},
		{
			"label": "pvp gateway start rate bypass",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/d",
				"/c",
				"set PVP_TEST_FORCE_BOT_MATCH=true&&set PVP_AI_QUEUE_TIMEOUT_MS=1500&&set DEV_BYPASS_RATE_LIMIT=true&&npm run pvp:gateway:start"
			],
			"isBackground": true
		},
		{
			"label": "pvp websocket dev stress",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/d",
				"/c",
				"load-tests\\pvp-websocket\\run-dev-stress.cmd"
			],
			"isBackground": false
		}
	]
}