{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "clean build",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/d",
				"/c",
				"if exist .next rmdir /s /q .next & npm run build"
			],
			"isBackground": false,
			"group": "build"
		}
	]
}