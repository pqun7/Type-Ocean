{
  "extends": "../../tsconfig.scripts.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "dist",
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
