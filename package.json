{
  "name": "type-space",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --watch",
    "test:ci": "jest --ci --passWithNoTests --runInBand --forceExit",
    "fonts:woff2": "python scripts/convert-fonts-to-woff2.py",
    "fonts:woff2:purge": "python scripts/convert-fonts-to-woff2.py --delete-sources",
    "pvp:gateway:build": "tsc -p services/pvp-gateway/tsconfig.json",
    "pvp:gateway:start": "node services/pvp-gateway/dist/services/pvp-gateway/src/index.js",
    "pvp:gateway:dev": "ts-node --transpile-only services/pvp-gateway/src/index.ts",
    "dev:redis": "npm run redis:start && next dev",
    "redis:start": "node ./scripts/redis-start.js",
    "stats:backfill:pvp-longterm": "ts-node --project tsconfig.scripts.json scripts/backfill-pvp-longterm-stats.ts",
    "redis:status": "sudo service redis-server status",
    "redis:restart": "sudo service redis-server restart",
    "admin:grant": "ts-node --project tsconfig.scripts.json scripts/grant-admin.ts",
    "drizzle:generate": "drizzle-kit generate --config drizzle.config.ts",
    "drizzle:push": "drizzle-kit push --config drizzle.config.ts",
    "drizzle:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "studio": "drizzle-kit studio",
    "drizzle:studio": "drizzle-kit studio --config drizzle.config.ts",
    "drizzle:check": "drizzle-kit check --config drizzle.config.ts",
    "prepare": "husky"
  },
